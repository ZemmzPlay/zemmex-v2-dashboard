// zemmz Live — data model.
// Extends the sketch in docs/08-build-to-production.md of the prototype handoff.
// Money is integer minor units; times are UTC instants shown in Event.timezone.

generator client {
  provider = "prisma-client-js"
  // native for local dev, musl for node:22-alpine images
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organisations, people who log in, roles
// ---------------------------------------------------------------------------

/// How the organisation pays (docs/prototype/05-pricing.md). Card billing isn't
/// built: zemmz activates a plan after invoicing, from /admin.
enum Plan {
  EVENT
  SEASON
  ENTERPRISE
  /// zemmz Play: 1 website, up to 2,000 players (AED 199 a month).
  PLAY_CLUB
  /// zemmz Play: 3 websites, 100,000 players, custom domain (AED 799 a month).
  PLAY_SEASON
  /// zemmz Play: publishers and federations, quoted.
  PLAY_PUBLISHER
}

enum PlanStatus {
  /// Free for the first TRIAL_ATTENDEES confirmed attendees across all events.
  TRIAL
  ACTIVE
  /// Kept for records; public registration is paused.
  SUSPENDED
}

model Organisation {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  /// "Event company or agency", "Hospital or medical body"… from onboarding.
  kind        String         @default("")
  country     String         @default("")
  plan        Plan           @default(EVENT)
  planStatus  PlanStatus     @default(TRIAL)
  activatedAt DateTime?
  createdAt   DateTime       @default(now())
  /// Shown on tax invoices to ticket buyers.
  legalName   String         @default("")
  /// VAT registration number (TRN in the UAE). Empty when not registered.
  vatNumber   String         @default("")
  /// Where ticket money is paid out to (zemmz collects, then pays out weekly).
  payoutAccountName String   @default("")
  payoutBankName    String   @default("")
  payoutIban        String   @default("")
  payoutSwift       String   @default("")
  /// A paid plan runs until here; renewal reminders and the grace period count from it.
  planEndsAt  DateTime?
  /// Single-event plan: events paid for and not yet used.
  eventCredits Int           @default(0)
  /// The last renewal reminder sent ("30d", "7d", "ended", "paused"), so each goes once.
  planReminder String        @default("")
  /// Enterprise single sign-on: people signing in with Microsoft or Google
  /// from this email domain join automatically once the domain is verified.
  ssoDomain           String?   @unique
  ssoDomainToken      String    @default("")
  ssoDomainVerifiedAt DateTime?
  /// Password sign-in refused for people at the domain.
  ssoRequired         Boolean   @default(false)
  ssoDefaultRole      Role      @default(EDITOR)
  memberships Membership[]
  payouts     Payout[]
  purchases   PlanPurchase[]
  playProjects PlayProject[]
  /// zemmz Play plan, separate from Live's: null while on the Play trial.
  playPlan     Plan?
  playPlanEndsAt DateTime?
  /// Play starts with 14 days of Season, from the first project.
  playTrialEndsAt DateTime?
  events      Event[]
  activity    ActivityLog[]
  invitations Invitation[]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  lastSeenAt   DateTime?
  /// Set when the 6-digit code from signup is entered. Invited people are verified by accepting.
  emailVerifiedAt DateTime?
  memberships  Membership[]
  sessions     AuthSession[]
  resets       PasswordReset[]
  emailCodes   EmailCode[]
  identities   UserIdentity[]
}

/// A Microsoft or Google account someone signs in with.
model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  /// The provider's stable id for the account (OIDC "sub", or "oid" for Microsoft).
  subject   String
  email     String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/// Someone asked to join an organisation by email. Only the token's SHA-256 is stored.
model Invitation {
  id             String       @id @default(cuid())
  organisationId String
  email          String
  role           Role
  tokenHash      String       @unique
  invitedById    String?
  invitedByLabel String       @default("")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The 6-digit code that proves a new account owns its email.
model EmailCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum RequestKind {
  DEMO
  CONTACT
  UPGRADE
}

/// "Book a demo", "Talk to us" and plan upgrade requests, for the zemmz team.
model ContactRequest {
  id           String      @id @default(cuid())
  kind         RequestKind
  name         String      @default("")
  email        String
  organisation String      @default("")
  message      String      @default("")
  plan         Plan?
  handledAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([handledAt, createdAt])
}

/// Owner and Admin manage everything; Editor manages content and messages but
/// not people with access; Check-in staff only see the check-in console.
enum Role {
  OWNER
  ADMIN
  EDITOR
  CHECKIN
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
}

/// Login sessions. The cookie holds a random token; only its SHA-256 is stored.
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

/// Mirrors EVENT_TYPE_KEYS in @zemmz/shared. The type sets vocabulary and modules.
enum EventType {
  conference
  medical
  summit
  concert
  workshop
  exhibition
  gala
}

/// Language of the public website's interface. BOTH adds a switch for visitors.
enum SiteLanguage {
  EN
  AR
  BOTH
}

enum CreditRule {
  duration
  checkin
}

model Event {
  id             String       @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  organisationId String
  type           EventType
  name           String
  shortName      String
  slug           String       @unique
  timezone       String
  startsOn       DateTime     @db.Date
  endsOn         DateTime     @db.Date
  currency       String       @default("AED")
  accentColour   String       @default("#321EDC")
  organiserName  String       @default("")
  heroText       String       @default("")
  venueName      String       @default("")
  venueAddress   String       @default("")
  venuePhone     String       @default("")

  // Quick settings: the three switches from the client's original deck.
  // They decide what the public homepage shows.
  registrationOpen Boolean    @default(true)
  afterEventOn     Boolean    @default(false)
  maintenance      Boolean    @default(false)
  siteLanguage     SiteLanguage @default(EN)
  /// Gates only: guests can scan out and back in with the same e-ticket.
  allowPassOut     Boolean    @default(true)
  /// VAT added to paid tickets, in basis points (500 = 5%). 0 for none.
  vatBps           Int        @default(0)
  /// The booking fee is added to what the buyer pays; otherwise it comes out of the takings.
  feePassedOn      Boolean    @default(true)
  /// Buyers can cancel and be refunded until this many hours before the start. Null: no self-service refunds.
  refundHours      Int?
  /// The event's website on the organiser's own domain, e.g. events.client.com.
  customDomain           String?   @unique
  customDomainToken      String    @default("")
  customDomainVerifiedAt DateTime?
  /// Built-in website pages left out of the menu: people, programme, venue.
  navHidden        String[]   @default([])

  // Medical only: how CME points are earned.
  creditRule         CreditRule @default(duration)
  creditThresholdPct Int        @default(75)
  requireEvaluation  Boolean    @default(false)

  /// Next public registration or ticket ID. IDs are never reused.
  nextPublicId   Int          @default(1001)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ticketTypes    TicketType[]
  promoCodes     PromoCode[]
  registrations  Registration[]
  orders         Order[]
  sessions       Session[]
  people         Person[]
  formFields     FormField[]
  pages          SitePage[]
  templates      MessageTemplate[]
  broadcasts     Broadcast[]
  outbox         OutboundMessage[]
  certificate    CertificateTemplate?
  afterPage      AfterEventPage?
  evalQuestions  EvaluationQuestion[]
  evalResponses  EvaluationResponse[]
  raffleDraws    RaffleDraw[]
  activity       ActivityLog[]
  assets         Asset[]        @relation("EventAssets")
  /// Shown in the website header, on badges and in emails.
  logoAssetId    String?        @unique
  logo           Asset?         @relation("EventLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  @@index([organisationId])
}

model TicketType {
  id          String   @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  eventId     String
  name        String
  description String   @default("")
  priceMinor  Int      @default(0)
  capacity    Int?
  onSale      Boolean  @default(true)
  sortOrder   Int      @default(0)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  gates       Session[]

  @@index([eventId])
}

model PromoCode {
  id         String   @id @default(cuid())
  eventId    String
  code       String
  percentOff Int
  maxUses    Int?
  uses       Int      @default(0)
  active     Boolean  @default(true)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([eventId, code])
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  /// Seat held while the buyer pays. Becomes CONFIRMED or CANCELLED.
  PENDING
}

enum RegistrationSource {
  WEBSITE
  DASHBOARD
  IMPORT
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  /// The number on the badge or e-ticket. Unique within the event, never reused.
  publicId      Int
  title         String             @default("")
  firstName     String
  lastName      String
  email         String
  mobile        String             @default("")
  /// The type's two profile fields, e.g. Speciality + Hospital, Role + Company.
  field1        String             @default("")
  field2        String             @default("")
  /// Answers to any extra form fields, keyed by FormField.key.
  answers       Json               @default("{}")
  ticketTypeId  String?
  orderId       String?
  status        RegistrationStatus @default(CONFIRMED)
  source        RegistrationSource @default(WEBSITE)
  consentMarketing Boolean         @default(false)
  /// The website language they registered in; their emails use it too.
  locale        String             @default("en")
  /// What the buyer paid for this ticket, VAT included, booking fee excluded.
  /// This is what a refund of this ticket returns.
  paidMinor     Int                @default(0)
  refundedAt    DateTime?
  badgePrintedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType    TicketType?        @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  order         Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attendance    Attendance[]
  certificate   CertificateIssue?
  evaluation    EvaluationResponse?
  raffleWins    RaffleDraw[]
  messages      OutboundMessage[]

  @@unique([eventId, publicId])
  @@index([eventId, email])
  @@index([eventId, lastName])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  eventId       String
  buyerName     String
  buyerEmail    String
  currency      String
  subtotalMinor Int
  discountMinor Int         @default(0)
  /// Platform fee: 2.5% + fixed, capped per ticket (docs/05-pricing.md).
  feeMinor      Int         @default(0)
  /// Whether the buyer pays the fee on top, or the organiser absorbs it.
  feePassedOn   Boolean     @default(true)
  /// VAT on the tickets, at the event's rate when the order was placed.
  vatMinor      Int         @default(0)
  vatBps        Int         @default(0)
  totalMinor    Int
  /// The provider's card processing charge (CARD_PROCESSING_BPS of the total), deducted from the payout.
  processingMinor Int       @default(0)
  refundedMinor Int         @default(0)
  promoCodeId   String?
  status        OrderStatus @default(PENDING)
  provider      String
  /// The provider's payment (Stripe payment intent, Tap charge) once known.
  providerRef   String?
  /// The provider's checkout (Stripe checkout session, Tap charge) while paying.
  providerSession String?
  locale        String      @default("en")
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  refunds       Refund[]

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoCode     PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([eventId, status])
  @@index([status, createdAt])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  /// The tickets this refund cancelled.
  registrationIds String[]
  amountMinor    Int
  status         RefundStatus @default(PENDING)
  providerRef    String?
  failure        String       @default("")
  /// "organiser" or "buyer" (self-service within the refund window).
  requestedBy    String
  byLabel        String       @default("")
  createdAt      DateTime     @default(now())

  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// An organisation paying zemmz for a plan by card. Bank transfers are recorded at /admin instead.
model PlanPurchase {
  id             String       @id @default(cuid())
  organisationId String
  plan           Plan
  currency       String       @default("AED")
  amountMinor    Int
  vatMinor       Int          @default(0)
  totalMinor     Int
  status         OrderStatus  @default(PENDING)
  provider       String
  providerSession String?
  providerRef    String?
  byLabel        String       @default("")
  createdAt      DateTime     @default(now())
  paidAt         DateTime?
  /// What the payment bought: the plan until this date.
  periodEnd      DateTime?
  /// How long it buys: 12 for a year; Play also sells single months.
  months         Int          @default(12)

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
}

/// Money zemmz has transferred to an organisation from ticket sales.
model Payout {
  id             String       @id @default(cuid())
  organisationId String
  currency       String
  amountMinor    Int
  reference      String       @default("")
  byLabel        String       @default("")
  createdAt      DateTime     @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, currency])
}

// ---------------------------------------------------------------------------
// Sessions, gates and attendance
// ---------------------------------------------------------------------------

enum SessionKind {
  SESSION
  GATE
}

enum SessionStatus {
  UPCOMING
  LIVE
  ENDED
}

model Session {
  id               String        @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  eventId          String
  kind             SessionKind   @default(SESSION)
  title            String
  chairs           String        @default("")
  location         String        @default("")
  startsAt         DateTime
  endsAt           DateTime
  capacity         Int?
  /// CME points for attending (medical only).
  credits          Float         @default(0)
  /// For gates: which ticket type this entrance accepts.
  gateTicketTypeId String?
  /// Kept current by the worker so lists and notifications don't recompute.
  status           SessionStatus @default(UPCOMING)
  sortOrder        Int           @default(0)
  /// After the event: a link to the recording on the organiser's video host.
  recordingUrl     String        @default("")
  slidesAssetId    String?       @unique
  slides           Asset?        @relation("SessionSlides", fields: [slidesAssetId], references: [id], onDelete: SetNull)
  /// A recording uploaded as a video file, instead of (or as well as) a link.
  recordingAssetId String?       @unique
  recording        Asset?        @relation("SessionRecording", fields: [recordingAssetId], references: [id], onDelete: SetNull)

  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gateTicketType   TicketType?   @relation(fields: [gateTicketTypeId], references: [id], onDelete: SetNull)
  attendance       Attendance[]

  @@index([eventId, startsAt])
  @@index([status, startsAt])
}

/// One interval in the room. Leaving and coming back creates a new row, so
/// time in the room is the sum of intervals (for CME) and pass-outs are exact.
/// A scan made on a device without a connection, uploaded later. The id is
/// made on the device, so uploading the same scan twice records it once.
model OfflineScan {
  id         String   @id
  sessionId  String
  kind       String
  title      String
  scannedAt  DateTime
  receivedAt DateTime @default(now())

  @@index([sessionId])
}

model Attendance {
  id             String       @id @default(cuid())
  registrationId String
  sessionId      String
  inAt           DateTime
  outAt          DateTime?
  scannedInById  String?
  scannedOutById String?

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, outAt])
  @@index([registrationId, sessionId])
}

// ---------------------------------------------------------------------------
// People on the programme
// ---------------------------------------------------------------------------

model Person {
  id        String  @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  eventId   String
  name      String
  category  String
  /// Key from the type's highlights, e.g. "dir" for Meeting director.
  highlight String  @default("")
  bio       String  @default("")
  photoUrl  String?
  photoAssetId String? @unique
  photo     Asset?  @relation("PersonPhoto", fields: [photoAssetId], references: [id], onDelete: SetNull)
  setTime   String  @default("")
  sortOrder Int     @default(0)
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Website
// ---------------------------------------------------------------------------

enum FieldKind {
  TEXT
  EMAIL
  PHONE
  DROPDOWN
  DATE
  TICKET
}

model FormField {
  id        String    @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  eventId   String
  /// title, first, last, email, mob, spec (field1), hosp (field2), or a custom key.
  key       String
  label     String
  kind      FieldKind
  required  Boolean   @default(false)
  enabled   Boolean   @default(true)
  /// Locked fields cannot be removed: name, email, ticket.
  locked    Boolean   @default(false)
  options   String[]  @default([])
  sortOrder Int       @default(0)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
}

model SitePage {
  id        String  @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  eventId   String
  key       String
  title     String
  bodyHtml  String  @default("")
  inNav     Boolean @default(true)
  sortOrder Int     @default(0)
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
}

// ---------------------------------------------------------------------------
// Messages
// ---------------------------------------------------------------------------

enum TemplateKind {
  CONFIRMATION
}

model MessageTemplate {
  id       String       @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  eventId  String
  kind     TemplateKind
  subject  String
  bodyHtml String
  kicker   String       @default("")
  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
}

enum Channel {
  EMAIL
  SMS
}

model Broadcast {
  id             String   @id @default(cuid())
  eventId        String
  audience       String
  channel        Channel
  subject        String
  bodyHtml       String
  recipientCount Int
  sentById       String?
  sentByLabel    String   @default("")
  createdAt      DateTime @default(now())
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages       OutboundMessage[]

  @@index([eventId, createdAt])
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

/// Outbox: the web app only ever inserts rows here; the worker delivers them.
model OutboundMessage {
  id                String         @id @default(cuid())
  eventId           String?
  registrationId    String?
  broadcastId       String?
  channel           Channel        @default(EMAIL)
  toAddress         String
  toName            String         @default("")
  subject           String
  html              String
  text              String
  status            DeliveryStatus @default(QUEUED)
  attempts          Int            @default(0)
  lastError         String?
  provider          String?
  providerMessageId String?
  sendAfter         DateTime       @default(now())
  /// When a worker took it. SENDING rows claimed long ago are released for retry.
  claimedAt         DateTime?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())

  event             Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration      Registration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  broadcast         Broadcast?     @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([status, sendAfter])
  @@index([eventId, createdAt])
}

// ---------------------------------------------------------------------------
// After the event
// ---------------------------------------------------------------------------

model CertificateTemplate {
  id             String  @id @default(cuid())
  eventId        String  @unique
  title          String
  activityNumber String  @default("")
  provider       String  @default("")
  /// Merge fields: {provider}, {credits}, {sessions}.
  bodyText       String
  signerName     String
  signerRole     String
  issueDateText  String
  minSessions    Int     @default(1)
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model CertificateIssue {
  id             String       @id @default(cuid())
  registrationId String       @unique
  credits        Float        @default(0)
  sessions       Int          @default(0)
  issuedAt       DateTime     @default(now())
  downloads      Int          @default(0)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model AfterEventPage {
  id            String  @id @default(cuid())
  /// Arabic versions of this row's text, by field name, for Arabic websites and emails. Empty fields fall back to the English.
  ar        Json      @default("{}")
  eventId       String  @unique
  showRecordings Boolean @default(false)
  showSlides    Boolean @default(false)
  showPhotos    Boolean @default(false)
  showSurvey    Boolean @default(false)
  /// Only people who checked in can open it.
  attendeesOnly Boolean @default(true)
  message       String  @default("")
  views         Int     @default(0)
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum QuestionKind {
  RATING
  CHECK
  CHOICE
  TEXT
}

model EvaluationQuestion {
  id        String       @id @default(cuid())
  eventId   String
  text      String
  kind      QuestionKind
  groupName String       @default("")
  required  Boolean      @default(false)
  sortOrder Int          @default(0)
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers   EvaluationAnswer[]

  @@index([eventId])
}

model EvaluationResponse {
  id             String       @id @default(cuid())
  eventId        String
  registrationId String       @unique
  submittedAt    DateTime     @default(now())
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  answers        EvaluationAnswer[]
}

model EvaluationAnswer {
  id         String             @id @default(cuid())
  responseId String
  questionId String
  rating     Int?
  checked    Boolean?
  text       String?
  response   EvaluationResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model RaffleDraw {
  id             String       @id @default(cuid())
  eventId        String
  registrationId String
  prize          String
  drawnAt        DateTime     @default(now())
  drawnByLabel   String       @default("")
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Audit trail — government buyers inspect this
// ---------------------------------------------------------------------------

model ActivityLog {
  id             String       @id @default(cuid())
  organisationId String
  eventId        String?
  actorId        String?
  actorLabel     String
  /// Past-tense sentence fragment: "checked in 38 delegates to Session 3".
  action         String
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([eventId, createdAt])
}

// ---------------------------------------------------------------------------
// Files: logos, photos, slides. Bytes live in storage (disk or S3), rows here.
// ---------------------------------------------------------------------------

enum AssetKind {
  LOGO
  PERSON_PHOTO
  GALLERY_PHOTO
  SLIDES
  VIDEO
  /// zemmz Play
  PLAY_LOGO
  TOURNAMENT_BANNER
  /// A player's result screenshot: only organisers and that match's players can open it.
  SCREENSHOT
}

model Asset {
  id             String    @id @default(cuid())
  organisationId String
  eventId        String?
  /// zemmz Play files belong to a project instead of an event.
  playProjectId  String?
  kind           AssetKind
  /// Storage key, also the path under /files/.
  key            String    @unique
  name           String
  contentType    String
  size           Int
  /// After-event photos and slides can be limited to people who came.
  attendeesOnly  Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  event          Event?    @relation("EventAssets", fields: [eventId], references: [id], onDelete: Cascade)
  logoOf         Event?    @relation("EventLogo")
  photoOf        Person?   @relation("PersonPhoto")
  slidesOf       Session?  @relation("SessionSlides")
  recordingOf    Session?  @relation("SessionRecording")

  @@index([eventId, kind])
}

// ---------------------------------------------------------------------------
// zemmz Play: tournament websites
// ---------------------------------------------------------------------------

/// One tournament website (the prototype's "project"), with its own players.
model PlayProject {
  id             String       @id @default(cuid())
  organisationId String
  slug           String       @unique
  name           String
  description    String       @default("")
  /// Brand colour; button text and link colours are derived with a contrast check.
  colour         String       @default("#3B25E5")
  timezone       String       @default("Asia/Dubai")
  siteLanguage   SiteLanguage @default(BOTH)
  heroTitle      String       @default("")
  heroText       String       @default("")
  /// Countdown on the website, e.g. to the season finals. Hidden when null.
  countdownLabel String       @default("")
  countdownAt    DateTime?
  rulesHtml      String       @default("")
  faqHtml        String       @default("")
  /// Social profiles by network: instagram, x, tiktok, youtube, twitch, discord…
  socials        Json         @default("{}")
  sponsors       String[]     @default([])
  logoAssetId    String?
  /// Arabic versions of the text above (see packages/shared/src/bilingual.ts).
  ar             Json         @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tournaments    Tournament[]
  players        PlayPlayer[]
  activity       PlayActivity[]

  @@index([organisationId])
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum TournamentStatus {
  /// Being set up; not on the website.
  DRAFT
  /// On the website. Registration follows its dates.
  PUBLISHED
  /// The bracket exists and matches are being played.
  LIVE
  ENDED
  CANCELLED
}

model Tournament {
  id              String           @id @default(cuid())
  projectId       String
  slug            String
  name            String
  /// A key from PLAY_GAMES in @zemmz/shared.
  game            String
  platform        String           @default("")
  format          TournamentFormat @default(SINGLE_ELIMINATION)
  /// 1 for solo; more for teams, which a captain forms and teammates join.
  teamSize        Int              @default(1)
  capacity        Int              @default(64)
  status          TournamentStatus @default(DRAFT)
  timezone        String           @default("Asia/Dubai")
  regOpensAt      DateTime
  regClosesAt     DateTime
  startsAt        DateTime
  endsAt          DateTime
  /// Best of 1, 3 or 5 (finals are always best of 5 in the prototype's copy).
  bestOf          Int              @default(3)
  /// Players upload their own results; otherwise only admins enter them.
  playersReport   Boolean          @default(true)
  /// Only players an admin has verified can register.
  verifiedOnly    Boolean          @default(false)
  /// Entrants must check in before the start; the bracket uses those who did.
  checkIn         Boolean          @default(false)
  /// ISO country codes that can take part; empty for anywhere.
  countries       String[]         @default([])
  description     String           @default("")
  rulesHtml       String           @default("")
  currency        String           @default("AED")
  /// Prizes by place: [{ place: 1, amountMinor: 500000, label: "" }, …].
  prizes          Json             @default("[]")
  /// Swiss rounds to play (0: worked out from the number of entrants).
  swissRounds     Int              @default(0)
  /// Entry fee per entrant (per team for teams); 0 for free. Paid through the same checkout as tickets.
  entryFeeMinor   Int              @default(0)
  currentRound    Int              @default(0)
  bannerAssetId   String?
  ar              Json             @default("{}")
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  endedAt         DateTime?

  project         PlayProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries         Entry[]
  matches         Match[]
  prizeAwards     PrizeAward[]
  entryOrders     EntryOrder[]

  @@unique([projectId, slug])
  @@index([projectId, status])
}

enum Verification {
  PENDING
  VERIFIED
  REJECTED
}

/// Someone with an account on a tournament website. Separate from organiser logins.
model PlayPlayer {
  id           String       @id @default(cuid())
  projectId    String
  firstName    String
  lastName     String
  /// The name shown in brackets.
  gamerTag     String
  email        String
  phone        String       @default("")
  country      String       @default("")
  locale       String       @default("en")
  verification Verification @default(PENDING)
  blacklisted  Boolean      @default(false)
  note         String       @default("")
  createdAt    DateTime     @default(now())
  lastSeenAt   DateTime?

  project      PlayProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions     PlayerSession[]
  memberships  EntryMember[]
  reports      ScoreReport[]

  @@unique([projectId, email])
  @@unique([projectId, gamerTag])
  @@index([projectId, verification])
}

model PlayerSession {
  id        String     @id @default(cuid())
  playerId  String
  tokenHash String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  player    PlayPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

/// A one-time code sent by email or SMS to sign in or sign up. Only the hash is kept.
model PlayerCode {
  id        String   @id @default(cuid())
  projectId String
  /// The email address or phone number it was sent to.
  target    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([projectId, target])
}

enum EntryStatus {
  /// Waiting for the entry fee.
  PENDING_PAYMENT
  REGISTERED
  CHECKED_IN
  WITHDRAWN
  DISQUALIFIED
}

/// A player or a team in one tournament.
model Entry {
  id           String      @id @default(cuid())
  tournamentId String
  /// The gamer tag for solo tournaments, the team name for teams.
  name         String
  captainId    String
  /// Teammates join with this code.
  joinCode     String      @default("")
  seed         Int?
  status       EntryStatus @default(REGISTERED)
  /// Final place once the tournament ends (ties share a place).
  place        Int?
  createdAt    DateTime    @default(now())

  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members      EntryMember[]

  @@unique([tournamentId, name])
  @@index([tournamentId, status])
}

model EntryMember {
  id       String     @id @default(cuid())
  entryId  String
  playerId String
  joinedAt DateTime   @default(now())
  entry    Entry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  player   PlayPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([entryId, playerId])
  @@index([playerId])
}

enum MatchStatus {
  /// Waiting for one or both entrants.
  PENDING
  /// Both entrants known; can be played and reported.
  READY
  /// At least one result uploaded, waiting for an admin.
  REVIEW
  /// Two results that disagree.
  CONFLICT
  /// An admin asked for a clearer screenshot.
  PROOF
  CONFIRMED
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  /// "W" winners/main bracket, "L" losers bracket, "F" grand final, "RR" round robin, "S" Swiss.
  bracket      String      @default("W")
  round        Int
  position     Int
  /// Round-robin group, when there are groups.
  groupName    String      @default("")
  entryAId     String?
  entryBId     String?
  /// Set when a slot will never be filled (a bye), so the other entrant goes through.
  aBye         Boolean     @default(false)
  bBye         Boolean     @default(false)
  scoreA       Int?
  scoreB       Int?
  winnerId     String?
  status       MatchStatus @default(PENDING)
  /// Where the winner and the loser go next (elimination brackets).
  nextMatchId  String?
  nextSlot     String?
  loserMatchId String?
  loserSlot    String?
  scheduledAt  DateTime?
  confirmedBy  String      @default("")
  confirmedAt  DateTime?
  note         String      @default("")

  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  reports      ScoreReport[]

  @@index([tournamentId, bracket, round])
  @@index([tournamentId, status])
}

/// A result uploaded by a player, with the screenshot.
model ScoreReport {
  id           String     @id @default(cuid())
  matchId      String
  entryId      String
  playerId     String
  scoreA       Int
  scoreB       Int
  screenshotAssetId String?
  /// Superseded when an admin asks for a new screenshot or the player sends another.
  replaced     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player       PlayPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

/// Paying a tournament's entry fee. The entry is held until it's paid.
model EntryOrder {
  id              String      @id @default(cuid())
  tournamentId    String
  entryId         String      @unique
  playerId        String
  currency        String
  amountMinor     Int
  /// The platform fee (docs/prototype/05), always paid by the player on top.
  feeMinor        Int
  totalMinor      Int
  processingMinor Int         @default(0)
  refundedMinor   Int         @default(0)
  status          OrderStatus @default(PENDING)
  provider        String
  providerSession String?
  providerRef     String?
  createdAt       DateTime    @default(now())
  paidAt          DateTime?

  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status])
}

/// A prize for a place, once the tournament ends, and whether it's been paid.
model PrizeAward {
  id           String     @id @default(cuid())
  tournamentId String
  place        Int
  entryId      String
  amountMinor  Int
  label        String     @default("")
  paidAt       DateTime?
  reference    String     @default("")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, place, entryId])
}

model PlayActivity {
  id         String      @id @default(cuid())
  projectId  String
  actorLabel String
  action     String
  createdAt  DateTime    @default(now())
  project    PlayProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
