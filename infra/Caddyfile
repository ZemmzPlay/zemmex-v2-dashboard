# Caddy 2 in front of the web container. With a real domain in SITE_ADDRESS
# (e.g. live.zemmz.com), Caddy obtains and renews TLS certificates itself.
#
# Event websites on an organiser's own domain (events.client.com, set up in
# the event's Settings → Web address) get certificates on demand: Caddy asks
# the app whether the domain is a verified event domain before issuing one.
{
	on_demand_tls {
		ask http://web:3000/api/domains/allowed
	}
}

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Long cache for Next.js build assets; they are content-hashed.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000 {
		header_up X-Forwarded-Host {host}
	}
}

{$SITE_ADDRESS::80} {
	import common
}

# Any other host: organisers' custom event domains.
https:// {
	tls {
		on_demand
	}
	import common
}
