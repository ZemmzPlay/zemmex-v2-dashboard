# Copy to .env and adjust. Every app reads this one file from the repository root.

# --- Database -------------------------------------------------------------
# Local: the native PostgreSQL 16 install (superuser password set at install).
# docker-compose: postgres://zemmz:zemmz@localhost:5432/zemmz
DATABASE_URL="postgresql://postgres:zemmz_local@localhost:5432/zemmz?schema=public"

# --- Web -------------------------------------------------------------------
# Public base URL, used in links inside emails.
APP_URL="http://localhost:3000"
# 32+ random characters. Signs nothing yet; reserved for signed links.
SESSION_SECRET="change-me-to-32-random-characters-min"

# --- Messaging ---------------------------------------------------------------
# "log"      : emails are stored and shown at /outbox (local development)
# "sendgrid" : emails are sent through SendGrid's v3 API with fetch
MESSAGING_PROVIDER="log"
SENDGRID_API_KEY=""
MAIL_FROM_ADDRESS="no-reply@zemmz.com"
MAIL_FROM_NAME="zemmz Live"
# Where demo, contact and upgrade requests from the website are emailed.
SALES_EMAIL="hello@zemmz.com"

# --- Payments ----------------------------------------------------------------
# zemmz is the merchant: buyers pay on the provider's hosted page, organisers
# are paid out weekly (record transfers at /admin, Payouts).
# "mock"   : a test page with approve and decline buttons; refused in production
# "stripe" : Stripe Checkout. Webhook: https://<host>/api/payments/stripe with the
#            checkout.session.* events; its signing secret goes below.
# "tap"    : Tap Payments (KNET, mada, Benefit, Apple Pay, cards). Webhooks are
#            set per charge, so there's nothing to configure in Tap's dashboard.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
TAP_SECRET_KEY=""
# What the provider charges per payment, passed on to organisers at cost (290 = 2.9%).
CARD_PROCESSING_BPS="0"

# zemmz's own details on the tax invoices it issues for plans.
ZEMMZ_LEGAL_NAME=""
ZEMMZ_VAT_NUMBER=""
ZEMMZ_ADDRESS=""

# --- Worker ------------------------------------------------------------------
WORKER_TICK_MS=20000

# --- zemmz staff --------------------------------------------------------------
# Comma-separated emails that can open /admin to activate plans and read
# demo and contact requests.
PLATFORM_ADMIN_EMAILS=""
