# Copy to .env and adjust. Every app reads this one file from the repository root.

# --- Database -------------------------------------------------------------
# Local: the native PostgreSQL 16 install (superuser password set at install).
# docker-compose: postgres://zemmz:zemmz@localhost:5432/zemmz
DATABASE_URL="postgresql://postgres:zemmz_local@localhost:5432/zemmz?schema=public"

# --- Web -------------------------------------------------------------------
# Public base URL, used in links inside emails.
APP_URL="http://localhost:3000"
# 32+ random characters. Signs nothing yet; reserved for signed links.
SESSION_SECRET="change-me-to-32-random-characters-min"

# --- Messaging ---------------------------------------------------------------
# "log"      : emails are stored and shown at /outbox (local development)
# "sendgrid" : emails are sent through SendGrid's v3 API with fetch
MESSAGING_PROVIDER="log"
SENDGRID_API_KEY=""
MAIL_FROM_ADDRESS="no-reply@zemmz.com"
MAIL_FROM_NAME="zemmz Live"

# --- Payments ----------------------------------------------------------------
# "mock" approves any card except 4000 0000 0000 0002. A regional provider is
# still to be chosen (see docs/HANDOVER.md, open questions).
PAYMENT_PROVIDER="mock"

# --- Worker ------------------------------------------------------------------
WORKER_TICK_MS=20000
